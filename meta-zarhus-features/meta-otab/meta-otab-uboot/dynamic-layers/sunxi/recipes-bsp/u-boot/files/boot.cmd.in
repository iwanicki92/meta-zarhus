# if otab_part_default is not defined yet, boot from 2 partition as default
if env exists otab_part_default; then
   setenv otab_part_current ${otab_part_default}
else
   setenv otab_part_current 2
fi

# Boot once into new system after update
if env exists otab_part_next; then
   setenv otab_part_current ${otab_part_next}
   setenv otab_part_next
fi

if test ${otab_part_current} -eq 3; then
   setenv otab_kernel_image "<OTAB_KERNEL_IMAGE_B>"
   setenv otab_root_device "<OTAB_LABEL_ROOTFS_B>"
else
   setenv otab_kernel_image "<OTAB_KERNEL_IMAGE_A>"
   setenv otab_root_device "<OTAB_LABEL_ROOTFS_A>"
fi

setenv otab_rootrwreset no
# Clear RW overlay on the next boot
if test -n ${otab_rootrwreset_next_boot}; then
  if test "${otab_rootrwreset_next_boot}" = "yes" ; then
     setenv otab_rootrwreset_next_boot no
     setenv otab_rootrwreset yes
  fi
else
  setenv otab_rootrwreset_next_boot no
fi

saveenv

fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs
setenv bootargs console=${console} console=tty1 root=LABEL=${otab_root_device} rootwait panic=10 ${extra} rootfstype=ext4 rootrw=LABEL=rwoverlay rootrwfstype=ext4 rootrwoptions=rw,noatime,data=journal,sync rootrwreset=${otab_rootrwreset}
saveenv
load <OTAB_STORAGE_DEVICE> 0:1 ${fdt_addr_r} ${fdtfile}
load <OTAB_STORAGE_DEVICE> 0:1 ${kernel_addr_r} ${otab_kernel_image}
if test ! -e <OTAB_STORAGE_DEVICE> 0:1 uboot.env; then saveenv; fi;
bootm ${kernel_addr_r} - ${fdt_addr_r}
