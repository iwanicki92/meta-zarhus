bootloader --timeout=0 --ptable gpt

part /boot  --source bootimg-partition  --fstype=vfat --label ${OTAB_LABEL_BOOT_A}          --align 2048    --fixed-size ${OTAB_BOOT_PART_SIZE}   --uuid ${BOOT_UUID}   --use-uuid --active
part        --source bootimg-partition  --fstype=vfat --label ${OTAB_LABEL_BOOT_B}          --align 2048    --fixed-size ${OTAB_BOOT_PART_SIZE}   --uuid ${BOOT_B_UUID} --use-uuid --active
part /      --source rootfs             --fstype=ext4 --label ${OTAB_LABEL_ROOTFS_A}        --align 2048    --fixed-size ${OTAB_ROOTFS_PART_SIZE} --uuid ${ROOT_UUID}   --use-uuid
part        --source rootfs             --fstype=ext4 --label ${OTAB_LABEL_ROOTFS_B}        --align 2048    --fixed-size ${OTAB_ROOTFS_PART_SIZE} --uuid ${ROOT_B_UUID} --use-uuid
part                                    --fstype=ext4 --label ${OTAB_LABEL_ROOTFS_OVERLAY}  --align 2048    --fixed-size ${OTAB_ROOTFS_OVERLAY_PART_SIZE}               --use-uuid
part /data  --source rootfs             --fstype=ext4 --label ${OTAB_LABEL_DATA}            --align 2048    --fixed-size ${OTAB_DATA_PART_SIZE}                         --use-uuid --rootfs-dir=${IMAGE_ROOTFS}${OTAB_DATA_DIR}
